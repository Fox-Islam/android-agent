<?xml version="1.0" encoding="utf-8"?>
<!--
  The card the agent stops behind: an approval, a plan, or a question of its own. Buttons are
  added at runtime because the number of them depends on what is being asked.

  It must never appear in the agent's own screenshots or accessibility tree - hence the shared
  overlay_root id, which ControlService filters out, and FLAG_SECURE on the window
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlay_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/overlay_card"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="14dp"
    android:paddingBottom="10dp">

    <TextView
        android:id="@+id/ask_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/ask_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:maxLines="8"
        android:ellipsize="end"
        android:textColor="#D8FFFFFF"
        android:textSize="13sp" />

    <LinearLayout
        android:id="@+id/ask_buttons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="end"
        android:orientation="horizontal" />
</LinearLayout>
